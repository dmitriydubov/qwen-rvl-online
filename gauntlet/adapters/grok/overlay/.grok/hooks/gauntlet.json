{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PROJECT_DIR:-${GROK_WORKSPACE_ROOT:-.}}/gauntlet/adapters/grok/grok_hooks.py\" session-start",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|MultiEdit|NotebookEdit|run_terminal_command|run_terminal_cmd|search_replace|write|hashline_edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PROJECT_DIR:-${GROK_WORKSPACE_ROOT:-.}}/gauntlet/adapters/grok/grok_hooks.py\" guard",
            "timeout": 30,
            "failClosed": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PROJECT_DIR:-${GROK_WORKSPACE_ROOT:-.}}/gauntlet/adapters/grok/grok_hooks.py\" stop --task gauntletFast --max-attempts 3 --timeout 1700",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(hardener|reviewer|gauntlet-card-[a-z0-9-]+|general-purpose)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PROJECT_DIR:-${GROK_WORKSPACE_ROOT:-.}}/gauntlet/adapters/grok/grok_hooks.py\" subagent-stop",
            "timeout": 7200
          }
        ]
      }
    ]
  }
}
